{
  "mcpServers": {
    "next-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "next-devtools-mcp@0.4"
      ],
      "env": {}
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "lunch-shops": {
      "type": "stdio",
      "command": "npx",
      "args": ["tsx", "mcp/shops-server.ts"],
      "env": {}
    }
  }
}